# PurFacted 2.0 - environment configuration
# Copy to .env and adjust. Every tunable value lives here or in the `config`
# DB table (R9) - nothing is hardcoded.

# --- App ---
NODE_ENV=development
APP_PORT=3000
# Public origin the app is served from (used for links, CSRF origin checks)
ORIGIN=http://localhost:3000

# --- PostgreSQL ---
POSTGRES_USER=purfacted
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=purfacted
# Local dev (npm run dev against compose services): host localhost.
# Inside docker compose the app overrides this with host "postgres".
DATABASE_URL=postgresql://purfacted:devpassword@localhost:5432/purfacted

# --- Redis ---
# Inside docker compose the app overrides this with host "redis".
REDIS_URL=redis://localhost:6379

# --- Tests ---
# Separate test database, wiped before integration test runs
TEST_DATABASE_URL=postgresql://purfacted:devpassword@localhost:5432/purfacted_test

# --- Email (R6) ---
# Leave SMTP_HOST empty in dev: mails land in the Redis dev mailbox instead
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=PurFacted <noreply@purfacted.com>
# none | starttls | tls
SMTP_ENCRYPTION=starttls
# Secret for signed tokens (e.g. unsubscribe links) - use a long random string
APP_SECRET=dev-secret-change-me
# Expose /api/dev/mailbox for local testing (must be false/empty in production)
EMAIL_DEV_MAILBOX=true

# Separate Redis logical DB for tests (never index 0)
TEST_REDIS_URL=redis://localhost:6379/1

# --- Bot prevention (R3/R19) ---
# Cloudflare Turnstile; leave empty to disable captcha verification (dev)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
