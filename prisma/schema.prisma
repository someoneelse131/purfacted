// PurFacted 2.0 - core domain schema (R2)
// Business rules live in REQUIREMENTS.md Part A; all tunable values are rows
// in the `config` table, never constants in code.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  VERIFIED
  EXPERT
  MODERATOR
  ORGANIZATION
  ADMIN
}

enum FactStatus {
  UNDER_REVIEW
  VERIFIED
  DISPUTED
  REFUTED
  UNSUBSTANTIATED
}

enum SourceType {
  PEER_REVIEWED
  OFFICIAL
  NEWS
  COMPANY
  BLOG
  OTHER
}

enum Side {
  PRO
  CONTRA
}

enum SourceStatus {
  ACTIVE
  REMOVED
}

enum CategoryStatus {
  ACTIVE
  PROPOSED
  REJECTED
  DISABLED
}

enum VetoStatus {
  OPEN
  SUCCEEDED
  FAILED
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  username        String    @unique
  passwordHash    String
  role            Role      @default(VERIFIED)
  reputation      Int       @default(0)
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  lastLoginAt     DateTime?
  banLevel        Int       @default(0)
  bannedUntil     DateTime?
  banReason       String?
  // captured on login; permanent bans block this address (R18)
  lastLoginIp     String?
  deletedAt       DateTime?

  // profile & settings (R7)
  bio          String?
  avatarUrl    String?
  pendingEmail String?
  hideStats    Boolean @default(false)
  notifyEmail  Boolean @default(true)

  sessions           Session[]
  emailVerifications EmailVerification[]
  passwordResets     PasswordReset[]
  facts              Fact[]
  sources            Source[]
  sourceVotes        SourceVote[]
  comments           Comment[]
  commentVotes       CommentVote[]
  vetoes             Veto[]
  expertCategories   ExpertCategory[]

  @@map("users")
}

// Expert status is bound to specific categories (R9/R29): the 3.0 base weight
// applies only inside these categories (and their children).
model ExpertCategory {
  userId     String
  categoryId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([userId, categoryId])
  @@map("expert_categories")
}

model Session {
  // id is the session token hash, set by the auth service (Lucia-style)
  id         String   @id
  userId     String
  expiresAt  DateTime
  // remember-me sessions slide with the longer expiry window
  rememberMe Boolean  @default(false)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model EmailVerification {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  // set when the token confirms an email *change* instead of the first verify
  newEmail  String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verifications")
}

model PasswordReset {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
}

model Category {
  id           String         @id @default(cuid())
  name         String
  slug         String         @unique
  parentId     String?
  status       CategoryStatus @default(ACTIVE)
  // set when a user proposed this category (R8); moderators decide
  proposedById String?
  createdAt    DateTime       @default(now())

  parent   Category?        @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[]       @relation("CategoryTree")
  facts    Fact[]
  experts  ExpertCategory[]

  @@index([parentId])
  @@index([status])
  @@map("categories")
}

model Fact {
  id              String                   @id @default(cuid())
  title           String
  body            String
  status          FactStatus               @default(UNDER_REVIEW)
  authorId        String
  categoryId      String
  reviewStartedAt DateTime                 @default(now())
  reviewDeadline  DateTime
  decidedAt       DateTime?
  // an UNSUBSTANTIATED fact can be revived exactly once (R13)
  revivedAt       DateTime?
  // set when moderation removes the fact (R17)
  deletedAt       DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  // generated column (see fact_search_vector migration), used via raw SQL
  searchVector    Unsupported("tsvector")? @default(dbgenerated("to_tsvector('english'::regconfig, ((COALESCE(title, ''::text) || ' '::text) || COALESCE(body, ''::text)))"))

  author   User      @relation(fields: [authorId], references: [id])
  category Category  @relation(fields: [categoryId], references: [id])
  sources  Source[]
  comments Comment[]
  vetoes   Veto[]

  @@index([status, categoryId])
  @@index([authorId])
  @@index([searchVector], type: Gin)
  @@map("facts")
}

model Source {
  id          String       @id @default(cuid())
  factId      String
  side        Side
  url         String
  title       String
  type        SourceType
  credibility Int
  addedById   String
  status      SourceStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())

  fact    Fact         @relation(fields: [factId], references: [id], onDelete: Cascade)
  addedBy User         @relation(fields: [addedById], references: [id])
  votes   SourceVote[]

  @@index([factId])
  @@map("sources")
}

model SourceVote {
  id        String   @id @default(cuid())
  sourceId  String
  userId    String
  value     Int // +1 / -1
  weight    Float // final weight at vote time (base x reputation modifier)
  createdAt DateTime @default(now())

  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sourceId, userId])
  @@map("source_votes")
}

model Comment {
  id        String    @id @default(cuid())
  factId    String
  parentId  String?
  authorId  String
  body      String
  createdAt DateTime  @default(now())
  editedAt  DateTime?
  deletedAt DateTime?

  fact     Fact          @relation(fields: [factId], references: [id], onDelete: Cascade)
  parent   Comment?      @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  children Comment[]     @relation("CommentThread")
  author   User          @relation(fields: [authorId], references: [id])
  votes    CommentVote[]

  @@index([factId])
  @@index([parentId])
  @@map("comments")
}

model CommentVote {
  id        String @id @default(cuid())
  commentId String
  userId    String
  value     Int // +1 / -1
  weight    Float

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@map("comment_votes")
}

model Veto {
  id             String      @id @default(cuid())
  factId         String
  submitterId    String
  reason         String
  status         VetoStatus  @default(OPEN)
  // fact status at veto time; the veto succeeds when the re-decision differs
  previousStatus FactStatus?
  createdAt      DateTime    @default(now())
  resolvedAt     DateTime?

  fact      Fact @relation(fields: [factId], references: [id], onDelete: Cascade)
  submitter User @relation(fields: [submitterId], references: [id])

  @@index([factId])
  @@map("vetoes")
}

enum ReportTargetType {
  FACT
  SOURCE
  COMMENT
  USER
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

// Content reports (R11 source flagging, full moderation queue in R17).
model Report {
  id           String           @id @default(cuid())
  targetType   ReportTargetType
  targetId     String
  reporterId   String
  reason       String
  detail       String?
  status       ReportStatus     @default(OPEN)
  // moderator currently working the item (R17)
  claimedById  String?
  createdAt    DateTime         @default(now())
  resolvedAt   DateTime?
  resolvedById String?

  @@index([status])
  @@index([targetType, targetId])
  @@map("reports")
}

// Append-only moderation audit trail (R17): who did what, when.
model ModerationAction {
  id          String   @id @default(cuid())
  moderatorId String
  action      String // e.g. claim_report, resolve_report_removed, approve_category
  targetType  String
  targetId    String
  detail      String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@map("moderation_actions")
}

// Permanently banned identifiers (R18): registration with these is rejected.
model BlockedIdentifier {
  id        String   @id @default(cuid())
  kind      String // EMAIL | IP
  value     String
  createdAt DateTime @default(now())

  @@unique([kind, value])
  @@map("blocked_identifiers")
}

model Config {
  key         String @id
  value       String
  description String

  @@map("config")
}
